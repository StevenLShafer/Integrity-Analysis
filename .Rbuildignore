# Repository files that are not part of the installable package.
^\.github$
^.*\.Rproj$
^\.Rproj\.user$
^app\.R$
^rsconnect$
^docs$
^handoff$
^CLAUDE\.md$
^ISSUES\.md$
^README\.md$
^LICENSE\.md$
# Working data and superseded local copies (untracked, but belt and braces:
# the Carlisle corpus spreadsheets must never ship in the bundle).
^.*Carlisle.*\.xlsx$
^One Sheet.*\.xlsx$
^TestPapers$
^parseCovariateTable\.R$
^testParseCovariateTable\.R$
^Integrity Analysis\.docx$
^IntegrityAnalysis\.docx$
